{
  "name": "dsh-goodjob",
  "description": "GoodJob — background jobs, waits, and agent operations for DeepSeek Harness",
  "version": "2026.8.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "tsc -p tsconfig.dev.json && tsdown",
    "test": "vitest run",
    "setup-dev": "node scripts/setup-dev.mjs",
    "setup-dev:undo": "node scripts/setup-dev.mjs --undo",
    "build:standalone": "tsc -p tsconfig.json && tsdown"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fentz26/dsh-goodjob.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-wait": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "jsdom": "^30.0.1"
  },
  "files": [
    "cordis.patch.yml",
    "docs",
    "SECURITY.md",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
